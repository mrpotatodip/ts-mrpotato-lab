{
  "include": [
    "src",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@repo/chat-bot-api": [
        "./src/vendor/chat-bot/chat-bot-api/src/index.ts"
      ],
      "@repo/chat-bot-api/*": [
        "./src/vendor/chat-bot/chat-bot-api/src/*"
      ],
      "@repo/chat-bot-durable-stream": [
        "./src/vendor/chat-bot/chat-bot-durable-stream/src/index.ts"
      ],
      "@repo/chat-bot-durable-stream/*": [
        "./src/vendor/chat-bot/chat-bot-durable-stream/src/*"
      ],
      "@repo/chat-bot-react": [
        "./src/vendor/chat-bot/chat-bot-react/src/index.ts"
      ],
      "@repo/chat-bot-react/*": [
        "./src/vendor/chat-bot/chat-bot-react/src/*"
      ],
      "@repo/chat-bot-react-loader": [
        "./src/vendor/chat-bot/chat-bot-react-loader/src/index.ts"
      ],
      "@repo/chat-bot-react-loader/*": [
        "./src/vendor/chat-bot/chat-bot-react-loader/src/*"
      ]
    }
  }
}
