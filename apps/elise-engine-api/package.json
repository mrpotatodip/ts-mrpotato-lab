{
  "name": "elise-engine-api",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:log": "wrangler dev > .dev.log 2>&1",
    "deploy": "node ../../scripts/deploy-guard.mjs apps/elise-engine-api && wrangler deploy",
    "build": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "live:get": "node tools/live-get.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && oxlint src && vitest run"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^1.0.3",
    "@repo/contracts": "workspace:*",
    "@repo/db-elise": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.9",
    "better-auth": "^1.6.25",
    "drizzle-orm": "0.45.2",
    "effect": "^3.21.4",
    "hono": "^4.3.7",
    "hono-openapi": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^22.19.19",
    "oxlint": "1.79.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7",
    "wrangler": "^4.147.0"
  }
}
