@baseUrl = http://localhost:8787
@account = 0b8c1d2e-3f4a-4b5c-8d6e-7f8091a2b3c4
@group = 9b2f6c1e-3a4d-4e5f-8a7b-1c2d3e4f5a6b
@person = 3f2a9c1e-7b64-4d0a-8e5f-1c2d3e4f5a6b

# These need the session of a login whose Role holds the group Powers (tenant_admin or workspace_admin).

GET {{baseUrl}}/groups
Authorization: Bearer <session-token>
x-account-id: {{account}}

###

POST {{baseUrl}}/groups
Authorization: Bearer <session-token>
x-account-id: {{account}}
Content-Type: application/json

{ "name": "Backend" }

###

PATCH {{baseUrl}}/groups/{{group}}
Authorization: Bearer <session-token>
x-account-id: {{account}}
Content-Type: application/json

{ "name": "Platform" }

###

DELETE {{baseUrl}}/groups/{{group}}
Authorization: Bearer <session-token>
x-account-id: {{account}}

###

# Put a member of the account in the group (twice is fine).
PUT {{baseUrl}}/groups/{{group}}/members/{{person}}
Authorization: Bearer <session-token>
x-account-id: {{account}}

###

DELETE {{baseUrl}}/groups/{{group}}/members/{{person}}
Authorization: Bearer <session-token>
x-account-id: {{account}}
