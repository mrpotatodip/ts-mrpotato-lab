{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EliseLAB Runner",
  "version": "0.1.0",
  "identifier": "com.eliselab.runner",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:3300",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EliseLAB Runner",
        "width": 460,
        "height": 600,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
