{
  "name": "ts-elise-lab",
  "packageManager": "pnpm@10.13.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "build": "pnpm --recursive build",
    "lint:branch": "node scripts/lint-branch-name.mjs",
    "prepare": "husky",
    "check": "pnpm --filter @repo/contracts --filter @repo/db-elise --filter elise-engine-api --filter elise-frontend-web check",
    "dev:stop": "node scripts/dev-stop.mjs",
    "check:apps": "node scripts/check-changed.mjs --all"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "react-doctor": "^0.9.12",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2",
      "@tanstack/ai>zod": "4.4.3",
      "zod": "4.4.3",
      "@tanstack/ai": "0.63.0",
      "@tanstack/ai-client": "0.36.0",
      "@tanstack/ai-react": "0.29.3"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "es5-ext",
      "esbuild",
      "lightningcss"
    ],
    "patchedDependencies": {
      "@tanstack/ai-client@0.36.0": "patches/@tanstack__ai-client@0.36.0.patch"
    }
  }
}
