{
  "name": "@repo/db-elise",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./test-db": "./src/test-db.ts"
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/seed.ts",
    "db:sync-powers": "tsx --env-file=.env src/sync-powers.ts",
    "db:add-superuser": "tsx --env-file=.env src/add-superuser.ts",
    "db:create-invite-code": "tsx --env-file=.env src/create-invite-code.ts",
    "check": "tsc --noEmit && tsx src/check-table-names.ts",
    "db:query": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/query.ts",
    "db:rehearse": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/rehearse.ts",
    "db:exec": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/exec.ts",
    "db:set-password": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/set-password.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@repo/chat-bot-durable-stream": "workspace:*",
    "@repo/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.19.19",
    "@types/pg": "8.20.0",
    "better-auth": "^1.6.25",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.10.1",
    "typescript": "^5.4.5"
  }
}
